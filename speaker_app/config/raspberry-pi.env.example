APP_PROFILE=raspberry-pi
APP_WINDOWED=false
APP_AUDIO_BACKEND=sounddevice
# Set an ALSA/PortAudio device name or numeric index only after checking the Pi.
APP_AUDIO_DEVICE=
APP_AUDIO_GAIN_DB=20.0
APP_AUDIO_DENOISE_ENABLED=true
APP_RETAIN_ENROLLMENT_AUDIO=true
APP_DATA_DIR=/app/data
APP_MODEL_DIR=/app/models
APP_MODEL_PATH=/app/models/ecapa_tdnn_protonet_model.pth
APP_MODEL_VERSION=ecapa-tdnn-protonet-v1
APP_INFERENCE_PROVIDER=cpu
APP_LOG_DIR=/app/logs
APP_LOG_LEVEL=INFO
APP_RECOGNITION_THRESHOLD=0.50
# Optional override. When empty, the image uses its built-in enrollment password.
ENROLLMENT_PASSWORD_HASH=

# Docker Hub image pushed by scripts/docker-buildx-push.sh.
SPEAKER_APP_IMAGE=docker.io/YOUR_DOCKERHUB_USER/protonet-speaker-app:rpi5

DISPLAY=:0
XAUTHORITY_FILE=/home/pi/.Xauthority
APP_UID=1000
APP_GID=1000
# Get this value on the Pi with: getent group audio | cut -d: -f3
AUDIO_GID=29
