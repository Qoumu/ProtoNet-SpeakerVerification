APP_PROFILE=raspberry-pi
APP_WINDOWED=false
APP_AUDIO_BACKEND=sounddevice
# Set an ALSA/PortAudio device name or numeric index only after checking the Pi.
APP_AUDIO_DEVICE=
APP_AUDIO_GAIN_DB=20.0
APP_AUDIO_DENOISE_ENABLED=true
APP_RETAIN_ENROLLMENT_AUDIO=true
APP_DATA_DIR=./data
APP_MODEL_PATH=../output/ecapa_tdnn_protonet_model.pth
APP_MODEL_VERSION=ecapa-tdnn-protonet-v1
APP_INFERENCE_PROVIDER=cpu
APP_LOG_DIR=./logs
APP_LOG_LEVEL=INFO

# Provisional until selected from held-out FAR/FRR evaluation.
APP_RECOGNITION_THRESHOLD=0.50

# Generate the persistent secret file with: python -m speaker_app.password_hash
# Optional overrides:
# ENROLLMENT_PASSWORD_HASH_FILE=./data/enrollment_password_hash
# ENROLLMENT_PASSWORD_HASH=
